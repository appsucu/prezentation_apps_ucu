---
interface Props { items: string[]; stat?: boolean }
const { items, stat } = Astro.props;
const html = (s: string) =>
  s.replace(/&/g, '&amp;')
   .replace(/<br\s*\/?>/gi, '___BR___')
   .replace(/</g, '&lt;')
   .replace(/>/g, '&gt;')
   .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
   .replace(/___BR___/g, '<br>')
   .replace(/\s*(?:\\n|\n)\s*/g, '<br>')
   .replace(/(?:^|\s+)\/n(?:\s+|$)/g, '<br>');
---
<div class:list={[
  'cards grid grid-cols-1 sm:grid-cols-2 w-full max-w-[980px] mt-[clamp(10px,1.5vh,20px)]',
  stat ? 'cards-stat gap-2 sm:gap-2.5' : 'gap-x-[clamp(18px,2.2vw,32px)] gap-y-0.5'
]}>
  {items.map((c, idx) => {
    const i = c.indexOf('·');
    if (stat && i > 0) {
      const isGreen = idx % 2 === 1;
      return (
        <div class:list={[
          'card stat px-3 py-[clamp(6px,0.95vh,11px)] rounded-lg border border-l-[3px] flex flex-col justify-center gap-0.5',
          isGreen
            ? 'bg-green/[0.11] border-green/25 border-l-green'
            : 'bg-purple/[0.06] border-purple/15 border-l-purple'
        ]}>
          <span class:list={[
            'stat-value font-display text-[clamp(1.2rem,1.8vw,1.65rem)] font-extrabold tracking-tight leading-none',
            isGreen ? 'text-[#3d6610]' : 'text-purple'
          ]} set:html={html(c.slice(0, i).trim())} />
          <span class="stat-label text-[clamp(0.76rem,0.88vw,0.88rem)] font-medium text-[#4a515c] leading-snug" set:html={html(c.slice(i + 1).trim())} />
        </div>
      );
    }
    if (i > 0) {
      return (
        <div class="card py-[clamp(6px,0.95vh,11px)] border-t border-[#d9dce0] flex items-start gap-2 text-[clamp(0.84rem,0.94vw,0.96rem)] leading-snug text-ink">
          <span class="text-purple font-extrabold shrink-0 mt-[2px] text-sm leading-none select-none">↗</span>
          <div class="leading-snug">
            <strong class="font-bold text-ink" set:html={html(c.slice(0, i).trim())} />
            <span class="text-purple/75 font-bold mx-1">·</span>
            <span class="text-[#4a515c] font-normal [&_strong]:font-bold [&_strong]:text-ink" set:html={html(c.slice(i + 1).trim())} />
          </div>
        </div>
      );
    }
    return (
      <div class="card py-[clamp(6px,0.95vh,11px)] border-t border-[#d9dce0] flex items-start gap-2 text-[clamp(0.84rem,0.94vw,0.96rem)] leading-snug text-[#4a515c]">
        <span class="text-purple font-extrabold shrink-0 mt-[2px] text-sm leading-none select-none">↗</span>
        <span class="leading-snug [&_strong]:font-bold [&_strong]:text-ink" set:html={html(c)} />
      </div>
    );
  })}
</div>
